# Copy to .env (git-ignored) or set these variables in the hosting control panel.

# --- Django core ---
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated host names, e.g. example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, e.g. https://example.com (optional)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Path to the SQLite database file (optional, default: <project>/db.sqlite3)
# DJANGO_SQLITE_PATH=/path/to/db.sqlite3

# --- Contact form -> Telegram (asia/views.py: form) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Shared hosting (passenger_wsgi.py / index.wsgi), optional ---
# Folder that contains manage.py (default: the folder of the WSGI file)
# DJANGO_PROJECT_PATH=/path/to/project
# site-packages of the server virtualenv
# VENV_SITE_PACKAGES=/path/to/venv/lib/python3.X/site-packages
